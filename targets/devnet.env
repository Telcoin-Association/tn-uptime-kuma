# Consensus monitor config — DEVNET.
# Sourced by consensus_monitor.sh. Keep this file's hostnames DISTINCT from testnet.env.
#
# PUSH_URL below is a PLACEHOLDER. The real push URL (with its secret token) lives in
# targets/devnet.env.local on the VM (gitignored), sourced AFTER this file so it wins.
# See the README "Security model" section. A fresh instance must create that override
# post-bootstrap, or this monitor's pushes go to a dead endpoint.

PUSH_URL="https://kuma.telscan.xyz/api/push/__REPLACE_DEVNET_PUSH_TOKEN__"
THRESHOLD=60

NODES=(
    "node1|https://node1.devnet.telcoin.network"
    "node2|https://node2.devnet.telcoin.network"
    "node3|https://node3.devnet.telcoin.network"
    "node4|https://node4.devnet.telcoin.network"
    "node5|https://node5.devnet.telcoin.network"
)
